        && a.bestTime==flowBestTime(b,c) && a.bestScore==flowBestScore(b,c) && a.winnerUids==winners
        && a.status==(done?'finished':b.status) && a.winnerUid==(done&&winners.size()==1?winners[0]:'')
        && a.winnerName==(done&&winners.size()==1?a.roundResults[winners[0]].name:'')
        && a.isDraw==(done&&winners.size()!=1)
        && a.timeLimitReached==(done&&a.bestTime==null&&a.bestScore>=0)
        && a.roundStartedAt==(b.get('roundStartedAt',null)==null?request.time:b.roundStartedAt)
        && a.latestEndedAt==(b.get('latestEndedAt',null)==null || c.endedAt>b.latestEndedAt?c.endedAt:b.latestEndedAt)
