rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    // Client-assisted podiums: source membership and exact increments are checked,
    // but Rules cannot prove that a browser selected the global best three.
    match /rankingMedalConfig/{id} { allow read: if true; allow write: if false; }
    match /rankingMedalAwards/{id} { allow read: if true; allow write: if false; }
    function medalStart() { return timestamp.date(2026,10,30); }
    function medalPad(n) { return n < 10 ? '0'+string(n) : string(n); }
    function medalDay(t) { return string(t.year())+'-'+medalPad(t.month())+'-'+medalPad(t.day()); }
    function medalWeek(t) {
      let thursday=t+duration.value(4-t.dayOfWeek(),'d');
      let week=int(math.floor((thursday.toMillis()-timestamp.date(thursday.year(),1,1).toMillis()) / 604800000))+1;
      return string(thursday.year())+'-W'+medalPad(week);
    }
    function medalKey(kind,t) { return kind=='today' ? medalDay(t) : kind=='month' ? string(t.year())+'-'+medalPad(t.month()) : medalWeek(t); }
    function medalEnd(kind,t) { return kind=='today' ? t+duration.value(1,'d') : kind=='week' ? t+duration.value(7,'d') : timestamp.date(t.month()==12?t.year()+1:t.year(),t.month()==12?1:t.month()+1,1); }
    function medalFirst(kind) {
      let t=medalStart();
      return kind=='today'?t:kind=='week'?t+duration.value((8-t.dayOfWeek())%7,'d'):t.day()==1?t:medalEnd('month',t);
    }
    function medalBoundary(kind,t) {
      return kind in ['today','week','month'] && t is timestamp && t>=medalFirst(kind)
        && t==timestamp.date(t.year(),t.month(),t.day())
        && (kind!='week'||t.dayOfWeek()==1) && (kind!='month'||t.day()==1);
    }
    function medalJobShape(d,kind) {
      return d.keys().hasOnly(['v','kind','nextStart','leaseUid','leaseUntil','updatedAt'])
        && d.v==1 && d.kind==kind && medalBoundary(kind,d.nextStart)
        && d.leaseUid is string && d.leaseUntil is timestamp && d.updatedAt==request.time;
    }
    function medalLease(d) { return d.leaseUid==request.auth.uid && d.leaseUntil>request.time && d.leaseUntil<=request.time+duration.value(90,'s'); }
    function medalClosedCertificates(kind,t) {
      let prefix=kind+'_'+medalKey(kind,t)+'_';
      return existsAfter(/databases/$(database)/documents/rankingMedalPeriods/$(prefix+'single'))
        && existsAfter(/databases/$(database)/documents/rankingMedalPeriods/$(prefix+'ao5'))
        && existsAfter(/databases/$(database)/documents/rankingMedalPeriods/$(prefix+'tps'))
        && existsAfter(/databases/$(database)/documents/rankingMedalPeriods/$(prefix+'moves'));
    }
    match /rankingMedalJobs/{kind} {
      allow read: if true;
      allow create: if signedIn() && medalJobShape(request.resource.data,kind)
        && request.resource.data.nextStart==medalFirst(kind)
        && medalEnd(kind,request.resource.data.nextStart)<=request.time && medalLease(request.resource.data);
      allow update: if signedIn() && medalJobShape(request.resource.data,kind) && (
        (request.resource.data.nextStart==resource.data.nextStart
          && medalEnd(kind,resource.data.nextStart)<=request.time
          && resource.data.leaseUntil<=request.time && medalLease(request.resource.data))
        || (resource.data.leaseUid==request.auth.uid && request.resource.data.leaseUid==''
          && request.resource.data.leaseUntil==timestamp.value(0)
          && (request.resource.data.nextStart==resource.data.nextStart
            || (resource.data.leaseUntil>request.time
              && request.resource.data.nextStart==medalEnd(kind,resource.data.nextStart)
              && medalClosedCertificates(kind,resource.data.nextStart)))));
      allow delete: if false;
    }
    function medalSource(s,id,d) {
      let type=d.metric=='ao5'?'ao5':'single';
      let field=d.kind=='today'?'dayKey':d.kind=='week'?'weekKey':'monthKey';
      // Immutable v2 solves already passed the normal-event transaction Rules.
      // Recheck provenance, period and the selected metric without duplicating
      // the entire solve validator (Firestore has a 1,000-expression limit).
      return s.get('schemaVersion',0)==2 && s.source=='normal' && s.mode=='virtual'
        && s.valid==true && s.rankingType==type
        && s.createdAt>=d.startAt && s.createdAt<d.endAt && s[field]==d.key;
    }
    function medalWinner(d,i,id) {
      let w=d.winners[i];
      let s=get(/databases/$(database)/documents/solves/$(w.solveId)).data;
      let counter=getAfter(/databases/$(database)/documents/rankingMedals/$(w.uid)).data;
      let field=d.metric=='tps'?'tps':d.metric=='moves'?'moveCount':'time';
      return w.keys().hasOnly(['uid','solveId','value'])
        && medalSource(s,w.solveId,d) && s.uid==w.uid && w.value==s[field] && w.value>0
        && counter.lastPeriodId==id && counter.updatedAt==request.time;
    }
    function medalSorted(d,a,b) {
      return d.winners[a].uid!=d.winners[b].uid && (d.metric=='tps'
        ? d.winners[a].value>=d.winners[b].value : d.winners[a].value<=d.winners[b].value);
    }
    function medalProblem(d) {
      let s=get(/databases/$(database)/documents/solves/$(d.problemSolveId)).data;
      let field=d.kind=='today'?'dayKey':d.kind=='week'?'weekKey':'monthKey';
      return s.get(field,'')==d.key && s.get('valid',false)==true
        && s.get('rankingType','')==(d.metric=='ao5'?'ao5':'single') && !medalSource(s,d.problemSolveId,d);
    }
    function medalCertificate(d,id) {
      let j=get(/databases/$(database)/documents/rankingMedalJobs/$(d.kind)).data;
      return d.keys().hasOnly(['v','kind','key','metric','startAt','endAt','status','winners','problemSolveId','finalizedBy','finalizedAt'])
        && d.v==1 && d.key==medalKey(d.kind,d.startAt)
        && d.metric in ['single','ao5','tps','moves'] && id==d.kind+'_'+d.key+'_'+d.metric
        && d.endAt==medalEnd(d.kind,d.startAt) && d.endAt<=request.time
        && j.nextStart==d.startAt && j.leaseUid==request.auth.uid && j.leaseUntil>request.time
        && d.finalizedBy==request.auth.uid && d.finalizedAt==request.time
        && d.winners is list && d.winners.size()<=3 && d.problemSolveId is string
        && ((d.status=='empty' && d.winners.size()==0 && d.problemSolveId=='')
          || (d.status=='unverifiable' && d.winners.size()==0 && medalProblem(d))
          || (d.status=='finalized' && d.problemSolveId=='' && d.winners.size()>0
            && medalWinner(d,0,id)
            && (d.winners.size()<2 || (medalWinner(d,1,id) && medalSorted(d,0,1)))
            && (d.winners.size()<3 || (medalWinner(d,2,id) && medalSorted(d,1,2) && d.winners[0].uid!=d.winners[2].uid))));
    }
    match /rankingMedalPeriods/{id} {
      allow read: if true;
      allow create: if signedIn() && medalCertificate(request.resource.data,id);
      allow update,delete: if false;
    }
    function medalIncrement(uid,before,after) {
      let id=after.lastPeriodId;
      let d=getAfter(/databases/$(database)/documents/rankingMedalPeriods/$(id)).data;
      let rank=d.winners[0].uid==uid?0:d.winners.size()>1 && d.winners[1].uid==uid?1:d.winners.size()>2 && d.winners[2].uid==uid?2:-1;
      return after.keys().hasOnly(['v','uid','gold','silver','bronze','lastPeriodId','updatedAt'])
        && after.v==1 && after.uid==uid && after.updatedAt==request.time
        && after.gold is int && after.silver is int && after.bronze is int
        && after.gold>=0 && after.silver>=0 && after.bronze>=0
        && !exists(/databases/$(database)/documents/rankingMedalPeriods/$(id))
        && d.status=='finalized' && rank>=0
        && after.gold==before.get('gold',0)+(rank==0?1:0)
        && after.silver==before.get('silver',0)+(rank==1?1:0)
        && after.bronze==before.get('bronze',0)+(rank==2?1:0);
    }
    match /rankingMedals/{uid} {
      allow read: if true;
      allow create: if signedIn() && medalIncrement(uid,{},request.resource.data);
      allow update: if signedIn() && medalIncrement(uid,resource.data,request.resource.data);
      allow delete: if false;
    }
    
    function isRealFriendRoom(roomId) {
      let room = get(
        /databases/$(database)/documents/battleRooms/$(roomId)
      ).data;

      return room.mode == "friend" && room.cubeMode == "real";
    }

    function validSolve() {
      return signedIn()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.time is number
        && request.resource.data.time > 2
        && request.resource.data.time < 3600
        && request.resource.data.scramble is string
        && request.resource.data.scramble.size() > 0
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 24
        && request.resource.data.moveCount is int
        && request.resource.data.moveCount >= 0
        && request.resource.data.rankingType in ["single", "ao5"]
        && (
          !("moves" in request.resource.data) ||
          (
            request.resource.data.moves is list &&
            request.resource.data.moves.size() <= 1000
           )
        );
    }
    
    function validRankedHostUpdate(uid) {
      let roomId = request.resource.data.lastRatedRoomId;
      let room = getAfter(
        /databases/$(database)/documents/battleRooms/$(roomId)
      ).data;

      return request.resource.data.lastRatedRoomId is string
        && request.resource.data.lastRatedRound is int
        && room.mode == "ranked"
        && room.status == "finished"
        && room.ratingApplied == true
        && room.ratingUpdated == true
        && get(/databases/$(database)/documents/battleRooms/$(roomId)).data.get('ratingUpdated',false)==false
        && (room.hostUid == request.auth.uid || (room.get('flowVersion',0) == 3 && room.guestUid == request.auth.uid))
        && room.round == request.resource.data.lastRatedRound
        && room.ratingChanges[uid].before == resource.data.rating
        && room.ratingChanges[uid].after == request.resource.data.rating;
    }


    // Daily-only paths. Published by an authenticated administrator outside the
    // website; no browser identity (including Google users) can publish days.
    function dailyGoogle() {
      return signedIn() && request.auth.token.firebase.sign_in_provider == 'google.com';
    }
    function dailyDay(day) {
      return get(/databases/$(database)/documents/dailyChallenges/$(day)).data;
    }
    function dailyResultValid(a) {
      return a.timeMs is int && a.timeMs >= 10 && a.timeMs <= 600000
        && a.moveCount is int && a.moveCount >= 1 && a.moveCount <= 2000
        && a.tps is number && a.tps >= 0 && a.tps <= 100
        && a.tps >= a.moveCount * 1000.0 / a.timeMs - 0.011
        && a.tps <= a.moveCount * 1000.0 / a.timeMs + 0.011
        && request.time >= resource.data.startedAt + duration.value(a.timeMs - 100, 'ms');
    }
    match /dailyChallenges/{day} {
      allow get: if resource.data.opensAt <= request.time;
      allow list, create, update, delete: if false;
      match /attempts/{uid} {
        allow get: if signedIn() && request.auth.uid == uid;
        allow list, delete: if false;
        allow create: if dailyGoogle() && request.auth.uid == uid
          && request.resource.data.keys().hasOnly(['uid','date','status','startedAt','operationId','name'])
          && request.resource.data.uid == uid && request.resource.data.date == day
          && request.resource.data.status == 'started'
          && request.resource.data.startedAt == request.time
          && request.resource.data.operationId is string && request.resource.data.operationId.size() == 36
          && request.resource.data.name is string && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 80
          && dailyDay(day).opensAt <= request.time && request.time < dailyDay(day).closesAt;
        allow update: if dailyGoogle() && request.auth.uid == uid
          && resource.data.status == 'started'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','completedAt','timeMs','moveCount','tps'])
          && request.resource.data.completedAt == request.time
          && (
            (request.resource.data.status == 'dnf'
              && request.resource.data.keys().hasOnly(['uid','date','status','startedAt','operationId','name','completedAt']))
            || (request.resource.data.status == 'completed'
              && request.time < dailyDay(day).closesAt
              && request.time < resource.data.startedAt + duration.value(10, 'm')
              && dailyResultValid(request.resource.data)
              && getAfter(/databases/$(database)/documents/dailyChallenges/$(day)/results/$(uid)).data == request.resource.data)
          );
      }
      match /results/{uid} {
        allow read: if dailyDay(day).opensAt <= request.time;
        allow update, delete: if false;
        allow create: if dailyGoogle() && request.auth.uid == uid
          && get(/databases/$(database)/documents/dailyChallenges/$(day)/attempts/$(uid)).data.status == 'started'
          && getAfter(/databases/$(database)/documents/dailyChallenges/$(day)/attempts/$(uid)).data.status == 'completed'
          && request.resource.data == getAfter(/databases/$(database)/documents/dailyChallenges/$(day)/attempts/$(uid)).data;
      }
    }

// Canonical stage-one aggregates. Legacy /users counters cannot write these paths.
    function profileBase(uid) {
      return exists(/databases/$(database)/documents/users/$(uid)/profileStats/current)
        ? get(/databases/$(database)/documents/users/$(uid)/profileStats/current).data : {};
    }
    function profileSummaryValid(uid,a) {
      let e = getAfter(/databases/$(database)/documents/users/$(uid)/profileEvents/$(a.lastEventId)).data;
      let b = profileBase(uid);
      return a.keys().hasOnly(['v','scope','trackingStartedAt','updatedAt','lastEventId','normalSolves','totalMoves','totalTimeMs','tpsMilliSum','pbMs','ao5Ms','ao12Ms','rankedBattles','rankedWins','rankedLosses','rankedDraws','rankedDnfs','friendBattles','friendWins','friendLosses','friendDraws','friendDnfs'])
        && a.v == 1 && a.scope == 'normal-virtual-and-human-battles-v1'
        && a.updatedAt == request.time
        && a.trackingStartedAt == b.get('trackingStartedAt',request.time)
        && !exists(/databases/$(database)/documents/users/$(uid)/profileEvents/$(a.lastEventId))
        && e.uid == uid && e.id == a.lastEventId && e.createdAt == request.time
        && a.normalSolves == b.get('normalSolves',0) + (e.kind == 'normal' ? 1 : 0)
        && a.totalMoves == b.get('totalMoves',0) + (e.kind == 'normal' ? e.moveCount : 0)
        && a.totalTimeMs == b.get('totalTimeMs',0) + (e.kind == 'normal' ? e.timeMs : 0)
        && a.tpsMilliSum == b.get('tpsMilliSum',0) + (e.kind == 'normal' ? e.tpsMilli : 0)
        && a.pbMs == (e.kind == 'normal' ? (b.get('pbMs',0) == 0 || e.timeMs < b.pbMs ? e.timeMs : b.pbMs) : b.get('pbMs',0))
        && a.ao5Ms == (e.kind == 'normal' ? e.ao5Ms : b.get('ao5Ms',0))
        && a.ao12Ms == (e.kind == 'normal' ? e.ao12Ms : b.get('ao12Ms',0))
        && a.rankedBattles == b.get('rankedBattles',0) + (e.kind == 'ranked' ? 1 : 0)
        && a.rankedWins == b.get('rankedWins',0) + (e.kind == 'ranked' && e.result == 'win' ? 1 : 0)
        && a.rankedLosses == b.get('rankedLosses',0) + (e.kind == 'ranked' && e.result == 'loss' ? 1 : 0)
        && a.rankedDraws == b.get('rankedDraws',0) + (e.kind == 'ranked' && e.result == 'draw' ? 1 : 0)
        && a.rankedDnfs == b.get('rankedDnfs',0) + (e.kind == 'ranked' && e.result == 'dnf' ? 1 : 0)
        && a.friendBattles == b.get('friendBattles',0) + (e.kind == 'friend' ? 1 : 0)
        && a.friendWins == b.get('friendWins',0) + (e.kind == 'friend' && e.result == 'win' ? 1 : 0)
        && a.friendLosses == b.get('friendLosses',0) + (e.kind == 'friend' && e.result == 'loss' ? 1 : 0)
        && a.friendDraws == b.get('friendDraws',0) + (e.kind == 'friend' && e.result == 'draw' ? 1 : 0)
        && a.friendDnfs == b.get('friendDnfs',0) + (e.kind == 'friend' && e.result == 'dnf' ? 1 : 0);
    }
function profileMin(a,b) { return a < b ? a : b; }
    function originalActivityDay(uid,e) {
      return e.get('featureVersion',2) == 3
        ? int(get(/databases/$(database)/documents/battleRooms/$(e.roomId)).data.finishedAt.date().toMillis() / 86400000)
        : int(request.time.date().toMillis() / 86400000);
    }
    function activityValues(uid,e,b) {
      let known = exists(/databases/$(database)/documents/users/$(uid)/activityDays/$(string(e.utcDay)));
      let cal = e.get('featureVersion',2) == 3 ? getAfter(/databases/$(database)/documents/users/$(uid)/activityCalendar/current).data : {};
      let streak = e.utcDay == b.get('lastDayIndex',-1) ? b.currentStreak : (e.utcDay == b.get('lastDayIndex',-1)+1 ? b.get('currentStreak',0)+1 : 1);
      return e.get('featureVersion',2) == 3
        ? {'activeDays':cal.days,'lastDayIndex':cal.lastDay,'currentStreak':cal.current,'longestStreak':profileMax(b.get('longestStreak',0),cal.longest),'valid':cal.days == b.get('activeDays',0)+(known?0:1)}
        : {'activeDays':b.get('activeDays',0)+(known?0:1),'lastDayIndex':e.utcDay,'currentStreak':streak,'longestStreak':profileMax(b.get('longestStreak',0),streak),'valid':e.utcDay >= b.get('lastDayIndex',-1)};
    }
    function calendarInsertValid(uid,a,b) {
      let day=a.insertDay;
      let i=a.insertIndex;
      let runs=b.runs;
      let left=i<runs.size()?runs[i]:{'start':day+2,'end':day+2};
      let touches=i<runs.size() && left.start<=day+1;
      let start=touches?profileMin(day,left.start):day;
      let end=touches?profileMax(day,left.end):day;
      let merge=touches && i+1<runs.size() && runs[i+1].start==end+1;
      let lastEnd=merge?runs[i+1].end:end;
      let removed=touches?(merge?[left,runs[i+1]]:[left]):[];
      return day is int && day>=0 && i is int && i>=0 && i<=runs.size()
        && (i==0 || runs[i-1].end<day-1)
        && (i==runs.size() || left.end>=day-1)
        && (!touches || day<left.start || day>left.end)
        && a.runs.size()==runs.size()-removed.size()+1 && a.runs[i]=={'start':start,'end':lastEnd}
        && a.runs.removeAll([a.runs[i]])==runs.removeAll(removed)
        && a.days==b.days+1 && a.lastDay==a.runs[a.runs.size()-1].end
        && a.current==a.lastDay-a.runs[a.runs.size()-1].start+1
        && a.longest==profileMax(b.longest,lastEnd-start+1)
        && (exists(/databases/$(database)/documents/users/$(uid)/activityDays/$(string(day))) ||
            getAfter(/databases/$(database)/documents/users/$(uid)/activityDays/$(string(day))).data.dayIndex==day);
    }
    match /users/{uid}/activityCalendar/{id} {
      allow read: if signedIn() && request.auth.uid==uid;
      allow create: if signedIn() && request.auth.uid==uid && id=='current'
        && request.resource.data=={'v':1,'runs':[],'days':0,'lastDay':-1,'current':0,'longest':0,'insertDay':-1,'insertIndex':0,'updatedAt':request.time};
      allow update: if signedIn() && request.auth.uid==uid && id=='current'
        && request.resource.data.keys().hasOnly(['v','runs','days','lastDay','current','longest','insertDay','insertIndex','updatedAt'])
        && request.resource.data.v==1 && request.resource.data.updatedAt==request.time
        && calendarInsertValid(uid,request.resource.data,resource.data);
      allow delete: if false;
    }
    function profileMax(a,b) { return a > b ? a : b; }
    function profileDetailBase(uid) {
      return exists(/databases/$(database)/documents/users/$(uid)/profileStats/details)
        ? get(/databases/$(database)/documents/users/$(uid)/profileStats/details).data : {};
    }
    function profileDetailsValid(uid,d) {
      let b = profileDetailBase(uid);
      let c = profileBase(uid);
      let a = getAfter(/databases/$(database)/documents/users/$(uid)/profileStats/current).data;
      let e = getAfter(/databases/$(database)/documents/users/$(uid)/profileEvents/$(d.lastEventId)).data;
      let continuous = b.size() == 0 || b.lastEventId == c.get('lastEventId','');
      let p = b.get('recentTimes',[]);
      let t = e.kind != 'normal' ? (continuous ? p : []) : [e.timeMs].concat(continuous ? p : [])[0:profileMin((continuous ? p.size() : 0)+1,12)];
      let bt = b.get('badgeTimes',{});
      let activity = activityValues(uid,e,b);
      let streak = e.utcDay == b.get('lastDayIndex',-1) ? b.currentStreak : (e.utcDay == b.get('lastDayIndex',-1)+1 ? b.get('currentStreak',0)+1 : 1);
      return e.featureVersion in [2,3] && a.lastEventId == e.id
        && !exists(/databases/$(database)/documents/users/$(uid)/profileEvents/$(d.lastEventId))
        && e.utcDay == originalActivityDay(uid,e)
        && activity.valid
        && d == {
          'v':2,'lastEventId':e.id,
          'trackingStartedAt':b.get('trackingStartedAt',request.time),'updatedAt':request.time,
          'coverageComplete':b.get('coverageComplete',true) && continuous,
          'activeDays':activity.activeDays,'lastDayIndex':activity.lastDayIndex,
          'currentStreak':activity.currentStreak,'longestStreak':activity.longestStreak,
          'bestTpsMilli':profileMax(b.get('bestTpsMilli',0),e.kind == 'normal' ? e.tpsMilli : 0),
          'lastSolveAt':e.kind == 'normal' ? request.time : b.get('lastSolveAt',null),
          'normalTrackingStartedAt':b.get('normalTrackingStartedAt',null) != null ? b.normalTrackingStartedAt : (e.kind == 'normal' ? request.time : null),
          'recentTimes':t,
          'badgeTimes':{
          'firstSolve': (bt.get('firstSolve',null) != null ? bt.firstSolve : ((a.normalSolves >= 1) && !( c.get('normalSolves',0) >= 1 ) ? request.time : null)),
          'solves100': (bt.get('solves100',null) != null ? bt.solves100 : ((a.normalSolves >= 100) && !( c.get('normalSolves',0) >= 100 ) ? request.time : null)),
          'solves1000': (bt.get('solves1000',null) != null ? bt.solves1000 : ((a.normalSolves >= 1000) && !( c.get('normalSolves',0) >= 1000 ) ? request.time : null)),
          'sub30': (bt.get('sub30',null) != null ? bt.sub30 : ((a.pbMs > 0 && a.pbMs < 30000) && !( c.get('pbMs',0) > 0 && c.get('pbMs',0) < 30000 ) ? request.time : null)),
          'sub20': (bt.get('sub20',null) != null ? bt.sub20 : ((a.pbMs > 0 && a.pbMs < 20000) && !( c.get('pbMs',0) > 0 && c.get('pbMs',0) < 20000 ) ? request.time : null)),
          'sub10': (bt.get('sub10',null) != null ? bt.sub10 : ((a.pbMs > 0 && a.pbMs < 10000) && !( c.get('pbMs',0) > 0 && c.get('pbMs',0) < 10000 ) ? request.time : null)),
          'firstWin': (bt.get('firstWin',null) != null ? bt.firstWin : ((a.rankedWins >= 1) && !( c.get('rankedWins',0) >= 1 ) ? request.time : null)),
          'wins10': (bt.get('wins10',null) != null ? bt.wins10 : ((a.rankedWins >= 10) && !( c.get('rankedWins',0) >= 10 ) ? request.time : null)),
          'wins100': (bt.get('wins100',null) != null ? bt.wins100 : ((a.rankedWins >= 100) && !( c.get('rankedWins',0) >= 100 ) ? request.time : null)),
          'streak7': (bt.get('streak7',null) != null ? bt.streak7 : ((d.longestStreak >= 7) && !( b.get('longestStreak',0) >= 7 ) ? request.time : null)),
