    function flowParticipants(r) { return r.mode=='friend' && r.get('maxPlayers',2)>2 ? r.get('activePlayerUids',[]) : [r.hostUid,r.guestUid]; }
    function flowExpiry(r,p) {
      let offline=p.updatedAt+duration.value(90,'s');
      let deadline=r.get('roundStartedAt',null)==null?offline:r.roundStartedAt+duration.value(300,'s');
      return offline<deadline?offline:deadline;
    }
    function flowBestTime(b,c) { return c.status=='finished' ? (b.get('bestTime',null)==null || c.time<b.bestTime ? c.time:b.bestTime) : b.get('bestTime',null); }
    function flowBestScore(b,c) { return c.status=='finished'?-1:(b.get('bestTime',null)!=null? -1:profileMax(b.get('bestScore',-1),c.status=='time_limit'?c.score:-1)); }
    function flowWinners(b,uid,c) {
