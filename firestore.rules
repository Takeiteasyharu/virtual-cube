        && a.diff(b).affectedKeys().hasOnly(['latestEndedAt','pendingParticipantUids','roundResults','resultCount','bestTime','bestScore','winnerUids','status','winnerUid','winnerName','isDraw','timeLimitReached','resultActorUid','updatedAt','finishedAt','roundStartedAt'])
        && a.pendingParticipantUids==(done?[]:flowParticipants(b))
        && a.roundResults.diff(results).affectedKeys().hasOnly([uid]) && a.roundResults.size()==results.size()+1 && a.resultCount==a.roundResults.size()
        && c.keys().hasOnly(['status','time','score','endedAt','name','round']) && c.round==b.round && c.name==p.name
        && c.status in ['finished','dnf','time_limit'] && c.score is int && c.score>=0 && c.score<=54
        && (c.status=='finished' ? c.time is number && c.time>=0.01 && c.time<3600 && c.score==0 && (b.get('roundStartedAt',null)==null || request.time<=b.roundStartedAt+duration.value(300,'s')) : c.time==null)
        && ((uid==request.auth.uid && c.endedAt==request.time && after.status==c.status && (c.status!='finished'||after.finalTime==c.time) && after.finishedAt==request.time)
